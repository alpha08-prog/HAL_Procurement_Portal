# HAL Procurement Portal - server environment (copy to server/.env)

PORT=3001

# JWT signing secret. The server falls back to a dev secret when unset; set it in any
# shared deployment.
JWT_SECRET=hal_nashik_procurement_secret_2026

# Where multer writes binary attachments. Relative paths resolve against server/.
STORAGE_PATH=./uploads

# SQLite file overrides (default: server/data/<module>.db). The check scripts point these
# at throwaway files; you normally leave them unset.
# NOTING_DB=./data/noting.db
# CONTRACTS_DB=./data/contracts.db
# APPROVALS_DB=./data/approvals.db
# AI_CASES_DB=./data/ai_cases.db
# REQUISITIONS_DB=./data/requisitions.db

# Contract payload encryption (AES-256-GCM), 32 bytes as hex or base64. When unset the
# server uses a fixed DEMO key and labels every finalised contract "demo key" in verify.
# CONTRACT_ENCRYPTION_KEY=

# Ollama for the AI-case note drafting. Notes are still produced when it is down.
OLLAMA_URL=http://localhost:11434
SLM_MODEL=qwen2.5:3b

# Demo one-time-password endpoint (GET /api/auth/otp-demo returns the signed-in user's
# current code). Set to false to hide it.
OTP_DEMO_ENDPOINT=true
